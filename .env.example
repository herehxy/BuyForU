# Agent 调用 DeepSeek 的本地密钥；真实值只写入被 Git 忽略的 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# 本地 Embedding 服务与固定模型。
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
# Docker Keycloak 首次启动管理员凭据。
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
# Agent -> Commerce 内部服务凭证，至少 32 字符且两端必须一致。
COMMERCE_MCP_SERVICE_TOKEN=
# Redis 仅保存流量协调状态；默认连接本机 Docker Compose 的 6379。
REDIS_HOST=localhost
REDIS_PORT=6379
# 仅当 Agent 前方存在反向代理时填写其精确来源地址，多个地址用逗号分隔。
TRUSTED_PROXY_ADDRESSES=
# 下列容量值均可按 DeepSeek 配额和机器规模覆盖。
DEEPSEEK_CONCURRENCY=20
MCP_READ_CONCURRENCY=32
MCP_WRITE_CONCURRENCY=16
EMBEDDING_CONCURRENCY=8
# 仅 production profile 使用的订单事件出口配置。
EVENT_WEBHOOK_URL=
EVENT_SIGNING_SECRET=
